<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Register your pharmacy — Panmacy</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="css/variables.css">
<link rel="stylesheet" href="css/base.css">
<link rel="stylesheet" href="css/components.css">
<link rel="stylesheet" href="css/pages/auth.css">
</head>
<body>
<header class="navbar">
  <div class="container navbar__inner">
    <a href="index.html" class="pm-logo">
      <svg class="pm-logo__mark" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="9" fill="#1D7A63"/><path d="M16 9v14M9 16h14" stroke="#FDFBF6" stroke-width="3.4" stroke-linecap="round"/><circle cx="23.5" cy="8.5" r="3" fill="#DB8B2C"/></svg>
      <span class="pm-logo__word">Panmacy</span>
    </a>
    <nav class="navbar__links" data-nav-drawer aria-label="Main menu">
      <a href="index.html" class="navbar__link">Browse Products</a>
      <a href="forum.html" class="navbar__link">Health Forum</a>
    </nav>
    <div class="navbar__actions">
      <a href="login.html" class="btn btn--sm btn--primary">Sign in</a>
    </div>
  </div>
</header>

<main class="container" style="padding:var(--sp-10) var(--sp-4);max-width:560px">
  <h1 style="font-family:var(--font-display);font-size:var(--fs-h2);margin-bottom:8px">Register your pharmacy</h1>
  <p style="color:var(--pm-ink-500);margin-bottom:var(--sp-6);font-size:var(--fs-small)">Join 140+ verified pharmacies on Panmacy. Approval usually takes 1–2 business days.</p>
  <div class="panel">
    <div class="panel__body">
      <form id="pharmacy-signup-form" style="display:grid;gap:16px">
        <div class="field">
          <label class="field__label" for="ps-name">Pharmacy name</label>
          <input type="text" id="ps-name" class="input" required placeholder="e.g. GreenLeaf Pharmacy">
        </div>
        <div class="field">
          <label class="field__label" for="ps-owner">Owner full name</label>
          <input type="text" id="ps-owner" class="input" required>
        </div>
        <div class="field">
          <label class="field__label" for="ps-email">Business email</label>
          <input type="email" id="ps-email" class="input" required>
        </div>
        <div class="field">
          <label class="field__label" for="ps-phone">Phone</label>
          <input type="tel" id="ps-phone" class="input" required>
        </div>
        <div class="field">
          <label class="field__label" for="ps-address">Address</label>
          <input type="text" id="ps-address" class="input" required>
        </div>
        <div class="field">
          <label class="field__label" for="ps-license">Pharmacy license number</label>
          <input type="text" id="ps-license" class="input" required placeholder="License ID">
        </div>
        <button type="submit" class="btn btn--primary btn--block">Submit application</button>
      </form>
    </div>
  </div>
</main>

<script src="js/main.js"></script>
<script>
document.getElementById('pharmacy-signup-form').addEventListener('submit', (e) => {
  e.preventDefault();
  pmToast('Application submitted — pending admin approval');
  setTimeout(() => { window.location.href = 'index.html'; }, 1500);
});
</script>
</body>
</html>
