<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sign Up — Panmacy</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="css/variables.css">
<link rel="stylesheet" href="css/base.css">
<link rel="stylesheet" href="css/components.css">
<link rel="stylesheet" href="css/pages/auth.css">
</head>
<body>

<%- include("element/nav") %>

<main class="auth-shell">

  <!-- DECORATIVE BRAND PANEL -->
  <section class="auth-panel" data-group="auth-illustration" aria-hidden="true">
    <div class="auth-panel__top"><span class="pm-logo__word">Panmacy</span></div>

    <div class="auth-panel__illustration">
      <svg viewBox="0 0 320 260" fill="none">
        <ellipse cx="160" cy="235" rx="120" ry="14" fill="rgba(0,0,0,.15)"/>
        <circle cx="160" cy="130" r="70" fill="#FDFBF6"/>
        <path d="M120 130a40 40 0 0180 0 40 40 0 01-80 0z" fill="#E3F1EA"/>
        <path d="M160 100v60M130 130h60" stroke="#1D7A63" stroke-width="7" stroke-linecap="round"/>
        <circle cx="235" cy="90" r="20" fill="#DB8B2C"/>
        <path d="M227 90l5 5 10-11" stroke="#FDFBF6" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="80" cy="95" r="14" fill="#279B7D" opacity=".85"/>
        <circle cx="70" cy="190" r="9" fill="#DB8B2C" opacity=".7"/>
      </svg>
    </div>

    <div>
      <div class="auth-panel__copy">
        <h2>Create your account in minutes</h2>
        <p>Sign up for member perks, order tracking, and access to our health forum</p>
      </div>
      <div class="auth-panel__stats">
        <div class="auth-panel__stat"><strong>50k+</strong><span>Trusted Members</span></div>
        <div class="auth-panel__stat"><strong>Free</strong><span>Membership Fee</span></div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       SIGN UP FORM
  ========================================================= -->
  <section class="auth-form-col">
    <div class="card auth-card" data-group="signup-form">
      <div class="auth-card__head">
        <h1>Create Your Account</h1>
        <p>Start caring for your and your family's health</p>
      </div>

      <form id="signup-form" method="post" action="/sign-up">
        <div class="field">
          <label class="field__label" for="username">Username</label>
          <div class="input-wrap">
            <svg class="leading-icon" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="6.5" r="3" stroke="currentColor" stroke-width="1.4"/><path d="M3.5 17c0-3.6 3-5.5 6.5-5.5s6.5 1.9 6.5 5.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
            <input class="input has-icon" type="text" id="username" placeholder="e.g. CK_FastFood" name="username" required>
          </div>
        </div>

        <div class="field">
          <label class="field__label" for="su-email">Email</label>
          <div class="input-wrap">
            <svg class="leading-icon" viewBox="0 0 20 20" fill="none"><rect x="2.5" y="4.5" width="15" height="11" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M3 5.5l7 5 7-5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
            <input class="input has-icon" type="email" id="su-email" placeholder="you@example.com" name="email" required>
          </div>
        </div>

        <div class="field">
          <label class="field__label" for="su-password">Password</label>
          <div class="input-wrap">
            <svg class="leading-icon" viewBox="0 0 20 20" fill="none"><rect x="4" y="9" width="12" height="8" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M6.5 9V6.5a3.5 3.5 0 017 0V9" stroke="currentColor" stroke-width="1.4"/></svg>
            <input class="input has-icon has-trailing" type="password" id="su-password" placeholder="Enter your password" data-password-input name="password" required>
            <button type="button" class="trailing-btn" data-password-toggle aria-label="Show password">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M1.5 9S4 4 9 4s7.5 5 7.5 5-2.5 5-7.5 5S1.5 9 1.5 9z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><circle cx="9" cy="9" r="2.2" stroke="currentColor" stroke-width="1.3"/></svg>
            </button>
          </div>
        </div>

        <div class="field" data-confirm-field>
          <label class="field__label" for="su-confirm">Confirm Password</label>
          <div class="input-wrap">
            <svg class="leading-icon" viewBox="0 0 20 20" fill="none"><rect x="4" y="9" width="12" height="8" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M6.5 9V6.5a3.5 3.5 0 017 0V9" stroke="currentColor" stroke-width="1.4"/></svg>
            <input class="input has-icon has-trailing" type="password" id="su-confirm" placeholder="Re-enter your password" data-confirm-input name="repassword" required>
            <button type="button" class="trailing-btn" data-password-toggle aria-label="Show password">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M1.5 9S4 4 9 4s7.5 5 7.5 5-2.5 5-7.5 5S1.5 9 1.5 9z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><circle cx="9" cy="9" r="2.2" stroke="currentColor" stroke-width="1.3"/></svg>
            </button>
          </div>
          <span class="field__error" data-confirm-error style="display:none;">Passwords do not match</span>
        </div>
        <div class="error-message">
              <%- msg %>
            </div>
        <button type="submit" class="btn btn--primary btn--lg btn--block" style="margin-top: var(--sp-6);">Create Account</button>
      </form>

      <p class="auth-foot">Already have an account? <a href="login">Log In</a></p>
    </div>
  </section>
</main>

<script src="js/main.js"></script>
<script src="js/pages/auth.js"></script>
</body>
</html>
