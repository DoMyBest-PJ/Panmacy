          <label class="filter-option"><input type="checkbox"> Medical Devices <span class="filter-option__count">61</span></label>
        </div>

        <div class="filter-group">
          <div class="filter-group__title">Price Range (THB)</div>
          <div class="price-inputs">
            <input type="number" class="input" placeholder="Min" value="0">
            <span>—</span>
            <input type="number" class="input" placeholder="Max" value="1500">
          </div>
        </div>

        <div class="filter-group">
