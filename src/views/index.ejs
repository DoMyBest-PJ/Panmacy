<main>

  <!-- =========================================================
       SEARCH BAND — search bar + popular category shortcuts
  ========================================================= -->
  <section class="search-band">
    <div class="container">
      <div class="search-band__title">
        <h1>Medicine you trust, delivered from pharmacies near you</h1>
        <p>Compare prices and stock from over 120 verified pharmacies nationwide</p>
      </div>

      <div class="search-bar">
        <div class="input-wrap">
          <svg class="leading-icon" viewBox="0 0 20 20" fill="none"><circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.6"/><path d="M17 17l-3.5-3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          <input type="search" class="input has-icon" placeholder="Search medicine, symptoms, or pharmacy name, e.g. Paracetamol">
        </div>
      </div>

      <!-- Popular categories -->
      <div class="category-strip chip-scroll">
        <button class="category-chip is-active" data-chip>
          <span class="category-chip__icon"><svg viewBox="0 0 16 16" fill="none"><rect x="2" y="2" width="12" height="12" rx="3" stroke="currentColor" stroke-width="1.3"/><path d="M8 2v12" stroke="currentColor" stroke-width="1.3"/></svg></span>
          All
        </button>
        <button class="category-chip" data-chip>
          <span class="category-chip__icon"><svg viewBox="0 0 16 16" fill="none"><rect x="3" y="6" width="10" height="7" rx="2" stroke="currentColor" stroke-width="1.3"/><path d="M5 6V4.5A1.5 1.5 0 016.5 3h3A1.5 1.5 0 0111 4.5V6" stroke="currentColor" stroke-width="1.3"/></svg></span>
          Pain Relief/Fever
        </button>
        <button class="category-chip" data-chip>
          <span class="category-chip__icon"><svg viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="5.5" stroke="currentColor" stroke-width="1.3"/><path d="M8 5v3l2 1.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg></span>
          Vitamins/Supplements
