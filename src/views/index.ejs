        <button class="category-chip" data-chip>
          <span class="category-chip__icon"><svg viewBox="0 0 16 16" fill="none"><path d="M8 2c2 2 4 4.5 4 7a4 4 0 11-8 0c0-2.5 2-5 4-7z" stroke="currentColor" stroke-width="1.3"/></svg></span>
          Skin/Cream
