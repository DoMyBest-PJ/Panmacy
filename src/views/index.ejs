<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Panmacy</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="css/variables.css">
  <link rel="stylesheet" href="css/base.css">
  <link rel="stylesheet" href="css/components.css">
  <link rel="stylesheet" href="css/pages/products.css">
</head>

<body>

  <%- include("element/nav") %>

  <main>
    <section class="search-band">
      <div class="container">
        <div class="search-band__title">
          <h1>Medicine you trust, delivered from pharmacies near you</h1>
          <p>Compare prices and stock from over 120 verified pharmacies nationwide</p>
        </div>

      <div class="search-bar">
        <div class="input-wrap">
          <svg class="leading-icon" viewBox="0 0 20 20" fill="none"><circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.6"/><path d="M17 17l-3.5-3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          <input type="search" class="input has-icon" placeholder="Search medicine, symptoms, or pharmacy name, e.g. Paracetamol">
        </div>
      </div>

      <!-- Popular categories -->
      <div class="category-strip chip-scroll">
        <button class="category-chip is-active" data-chip>
          <span class="category-chip__icon"><svg viewBox="0 0 16 16" fill="none"><rect x="2" y="2" width="12" height="12" rx="3" stroke="currentColor" stroke-width="1.3"/><path d="M8 2v12" stroke="currentColor" stroke-width="1.3"/></svg></span>
          All
        </button>
        <button class="category-chip" data-chip>
          <span class="category-chip__icon"><svg viewBox="0 0 16 16" fill="none"><rect x="3" y="6" width="10" height="7" rx="2" stroke="currentColor" stroke-width="1.3"/><path d="M5 6V4.5A1.5 1.5 0 016.5 3h3A1.5 1.5 0 0111 4.5V6" stroke="currentColor" stroke-width="1.3"/></svg></span>
          Pain Relief/Fever
        </button>
        <button class="category-chip" data-chip>
          <span class="category-chip__icon"><svg viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="5.5" stroke="currentColor" stroke-width="1.3"/><path d="M8 5v3l2 1.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg></span>
          Vitamins/Supplements
        </button>
        <button class="category-chip" data-chip>
          <span class="category-chip__icon"><svg viewBox="0 0 16 16" fill="none"><path d="M8 2c2 2 4 4.5 4 7a4 4 0 11-8 0c0-2.5 2-5 4-7z" stroke="currentColor" stroke-width="1.3"/></svg></span>
          Skin/Cream
        </button>
        <button class="category-chip" data-chip>
          <span class="category-chip__icon"><svg viewBox="0 0 16 16" fill="none"><path d="M5 3v3a3 3 0 006 0V3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M8 9v4M6 13h4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg></span>
          Respiratory
        </button>
        <button class="category-chip" data-chip>
          <span class="category-chip__icon"><svg viewBox="0 0 16 16" fill="none"><rect x="4" y="2" width="8" height="12" rx="2" stroke="currentColor" stroke-width="1.3"/><path d="M6.5 6h3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg></span>
          Mom & Baby
        </button>
        <button class="category-chip" data-chip>
          <span class="category-chip__icon"><svg viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.3"/><path d="M8 5.5v5M5.5 8h5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg></span>
          Medical Devices
        </button>
      </div>
    </div>
  </section>

    <!-- =========================================================
       BROWSE LAYOUT — sidebar filters + product results
  ========================================================= -->
    <div class="container page-body">
      <div class="browse-layout">

        <!-- ---------------- SIDEBAR: FILTERS ---------------- -->
        <aside class="filters card" data-filters aria-label="Product filters">
          <div class="filters__head">
            <h3>Filters</h3>
            <button class="filters__clear" type="button" data-filters-clear>Clear all</button>
          </div>

          <div class="filter-group" data-filter-group="category">
            <div class="filter-group__title">Product Category</div>
            <% [...new Set(rows.map(product => product.Category))].sort().forEach(category => { %>
            <label class="filter-option"><input type="checkbox" value="<%= category %>" data-filter="category"> <%= category %> <span class="filter-option__count"></span></label>
            <% }); %>
          </div>

          <div class="filter-group" data-filter-group="pharmacy">
            <div class="filter-group__title">Pharmacy</div>
            <% [...new Set(rows.map(product => product.PharmacyName))].sort().forEach(pharmacy => { %>
            <label class="filter-option"><input type="checkbox" value="<%= pharmacy %>" data-filter="pharmacy"> <%= pharmacy %> <span class="filter-option__count"></span></label>
            <% }); %>
          </div>
        </aside>

        <!-- ---------------- MAIN: RESULTS ---------------- -->
        <section aria-label="Product search results">
          <div class="results-toolbar">
            <button class="btn btn--outline btn--sm" data-filters-toggle style="display:none">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M1 3h12M4 7h6M6 11h2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
              </svg>
              Filters
            </button>
            <p class="results-toolbar__count" aria-live="polite">Found <strong data-results-count><%= rows.length %></strong> results</p>
            <div class="results-toolbar__sort">
              <label for="sort">Sort by</label>
              <select id="sort" class="select">
                <option value="latest">Latest</option>
                <option value="price-asc">Price: Low → High</option>
                <option value="price-desc">Price: High → Low</option>
              </select>
            </div>
          </div>

          <!-- Product grid -->
          <div class="product-grid">

            <!-- Product card -->
            <% rows.forEach(Product => { %>
            <article class="card product-card" data-price="<%= Product.Price %>" data-product-id="<%= Product.PharmacyProductID %>" data-search="<%= [Product.ProductName, Product.Category, Product.PharmacyName, Product.Description || ''].join(' ') %>">
              <div class="product-card__media tile--device">
                <div class="product-card__badges">
                  <% if(Product.Quantity > 0) { %>
                  <span class="badge badge--stock-ok">In Stock</span>
                  <% } else { %>
                  <span class="badge badge--stock-out">Out of Stock</span>
                  <% } %>

                </div>
                <svg viewBox="0 0 48 48" fill="none">
                  <rect x="14" y="10" width="20" height="28" rx="4" fill="currentColor" opacity=".18" />
                  <path d="M18 18h12M18 24h12M18 30h8" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
              </div>
              <div class="product-card__body">
                <span class="product-card__category"><%= Product.Category %></span>
                <h3 class="product-card__name"><%= Product.ProductName %></h3>
                <div class="product-card__pharmacy">
                  <svg viewBox="0 0 16 16" fill="none">
                    <path d="M2 6l1-3h10l1 3M2 6v7a1 1 0 001 1h10a1 1 0 001-1V6M2 6h12" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
                  </svg>
                  <%= Product.PharmacyName %>
                </div>
                <div class="product-card__price-row">
                  <span class="product-card__price">฿<%= Product.Price %></span>
                </div>
                <div class="product-card__actions">
                  <a href="/product/<%= Product.PharmacyProductID %>" class="btn btn--outline btn--sm">View Details</a>
                  <% if (isLogin && Product.Quantity > 0) { %>
                  <button type="button" class="btn btn--primary btn--sm" data-add-to-cart data-product-id="<%= Product.PharmacyProductID %>">
                    Add to Cart
                  </button>
                  <% } else if (isLogin) { %>
                  <button type="button" class="btn btn--primary btn--sm" disabled>
                    Out of Stock
                  </button>
                  <% } %>

                </div>
              </div>
            </article>
            <% }); %>
            <p class="product-grid__empty" data-empty-state hidden>No products match your search and filters.</p>
          </div>
        </section>
      </div>
    </div>
  </main>

  <!-- =========================================================
     FOOTER
========================================================= -->
  <footer class="footer">
    <div class="container footer__inner">
      <a href="index.html" class="pm-logo">
        <svg class="pm-logo__mark" viewBox="0 0 32 32" fill="none">
          <rect width="32" height="32" rx="9" fill="#1D7A63" />
          <path d="M16 9v14M9 16h14" stroke="#FDFBF6" stroke-width="3.4" stroke-linecap="round" />
          <circle cx="23.5" cy="8.5" r="3" fill="#DB8B2C" />
        </svg>
        <span class="pm-logo__word">Panmacy</span>
      </a>
      <div class="footer__cols">
        <div class="footer__col">
          <h4>Products</h4>
          <ul>
            <li><a href="index.html">Browse Products</a></li>
            <li><a href="cart.html">My Cart</a></li>
          </ul>
        </div>
        <div class="footer__col">
          <h4>Community</h4>
          <ul>
            <li><a href="forum.html">Health Forum</a></li>
            <li><a href="chat.html">Pharmacist Chat</a></li>
          </ul>
        </div>
        <div class="footer__col">
          <h4>Account</h4>
          <ul>
            <li><a href="login.html">Log In</a></li>
            <li><a href="signup.html">Sign Up</a></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="container">
      <p class="footer__note">© 2026 Panmacy. Every medicine purchase should follow a pharmacist's guidance</p>
    </div>
  </footer>



  <!-- Forum popup (Facebook-style) -->
  <div class="modal-backdrop" id="modal-forum" role="dialog" aria-modal="true" aria-labelledby="forum-modal-title">
    <div class="modal modal--fb">
      <div class="modal__header">
        <h2 class="modal__title" id="forum-modal-title">Create post</h2>
        <button type="button" class="modal__close" data-modal-close aria-label="Close">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
        </button>
      </div>
      <form id="forum-composer-form">
        <div class="modal__body">
          <div class="fb-post-composer">
            <div class="avatar">N</div>
            <textarea class="fb-post-input" name="content" placeholder="What's on your mind, Nattawat?" required></textarea>
          </div>
          <div class="fb-post-actions">
            <button type="button" class="fb-post-action">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                <rect x="2" y="3" width="14" height="12" rx="2" stroke="#45BD62" stroke-width="1.4" />
                <circle cx="6.5" cy="7.5" r="1.5" fill="#45BD62" />
                <path d="M2 12l3.5-3.5 2.5 2.5 3-3.5L16 12" stroke="#45BD62" stroke-width="1.4" stroke-linejoin="round" />
              </svg>
              Photo
            </button>
            <button type="button" class="fb-post-action">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                <path d="M3 14V5a1 1 0 011-1h4l1.5 2H14a1 1 0 011 1v7a1 1 0 01-1 1H4a1 1 0 01-1-1z" stroke="#F7B928" stroke-width="1.4" stroke-linejoin="round" />
              </svg>
              Tag
            </button>
            <button type="button" class="fb-post-action">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                <circle cx="9" cy="9" r="6.5" stroke="#F5533D" stroke-width="1.4" />
                <path d="M6 10.5c.8 1 1.9 1.5 3 1.5s2.2-.5 3-1.5M7 7.5h.01M11 7.5h.01" stroke="#F5533D" stroke-width="1.4" stroke-linecap="round" />
              </svg>
              Feeling
            </button>
          </div>
        </div>
        <div class="modal__footer">
          <button type="button" class="btn btn--ghost" data-modal-close>Cancel</button>
          <button type="submit" class="btn btn--primary">Post</button>
        </div>
      </form>
    </div>
  </div>

  <!-- New Thread popup -->
  <div class="modal-backdrop" id="modal-new-thread" role="dialog" aria-modal="true" aria-labelledby="thread-modal-title">
    <div class="modal modal--lg">
      <div class="modal__header">
        <h2 class="modal__title" id="thread-modal-title">Start a new thread</h2>
        <button type="button" class="modal__close" data-modal-close aria-label="Close">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
        </button>
      </div>
      <form id="new-thread-form">
        <div class="modal__body">
          <div class="field" style="margin-bottom:16px">
            <label class="field__label" for="thread-title">Title</label>
            <input type="text" id="thread-title" name="title" class="input" placeholder="e.g. Is it safe to take ibuprofen with antibiotics?" required>
          </div>
          <div class="field" style="margin-bottom:16px">
            <label class="field__label" for="thread-category">Category</label>
            <select id="thread-category" name="category" class="select" style="width:100%;height:46px">
              <option>General Health</option>
              <option>Pain Relief / Fever</option>
              <option>Cold &amp; Flu</option>
              <option>Allergy</option>
              <option>Digestive</option>
              <option>Skin Care</option>
              <option>Medication FAQ</option>
            </select>
          </div>
          <div class="field">
            <label class="field__label" for="thread-body">Your question or discussion</label>
            <textarea id="thread-body" name="body" class="input" style="height:140px;padding-top:12px;resize:vertical" placeholder="Describe your question in detail..." required></textarea>
          </div>
        </div>
        <div class="modal__footer">
          <button type="button" class="btn btn--ghost" data-modal-close>Cancel</button>
          <button type="submit" class="btn btn--primary">Post thread</button>
        </div>
      </form>
    </div>
  </div>

  <script src="js/main.js"></script>
  <script src="js/pages/products.js"></script>
</body>

</html>