                <span class="rating"><svg viewBox="0 0 16 16" fill="currentColor"><path d="M8 1.5l1.9 4.2 4.6.5-3.5 3 1 4.5L8 11.5 3.9 13.7l1-4.5-3.5-3 4.6-.5L8 1.5z"/></svg>4.4 <span class="rating__count">(58)</span></span>
              </div>
              <div class="product-card__price-row"><span class="product-card__price">฿590</span></div>
              <div class="product-card__actions">
                <a href="product.html" class="btn btn--outline btn--sm">View Details</a>
                <button class="btn btn--outline btn--sm" disabled>Out of Stock</button>
              </div>
            </div>
          </article>

        </div>

        <!-- Pagination -->
