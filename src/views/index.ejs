          <label class="filter-option"><input type="checkbox"> 24-Hr Community Pharmacy <span class="filter-option__count">88</span></label>
        </div>

        <div class="filter-group">
          <div class="filter-group__title">Rating</div>
          <div class="star-filter">
            <label><input type="radio" name="rating"> <span class="stars">★★★★★</span> & up</label>
            <label><input type="radio" name="rating"> <span class="stars">★★★★</span>☆ & up</label>
            <label><input type="radio" name="rating"> <span class="stars">★★★</span>☆☆ & up</label>
          </div>
        </div>

        <button class="btn btn--primary btn--block" type="button">Show Results</button>
