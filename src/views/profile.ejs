<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>My Profile — Panmacy</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="css/variables.css">
<link rel="stylesheet" href="css/base.css">
<link rel="stylesheet" href="css/components.css">
</head>
<body>

<%- include("element/nav") %>

<main class="container" style="padding:var(--sp-10) var(--sp-4);max-width:640px">
  <h1 style="font-family:var(--font-display);font-size:var(--fs-h2);margin-bottom:var(--sp-6)">My Profile</h1>
  <div class="panel">
    <div class="panel__body">
      <form id="profile-form" style="display:grid;gap:16px">
        <div class="field">
          <label class="field__label" for="pf-name">Full name</label>
          <input type="text" id="pf-name" class="input" value="Nattawat Srisuk">
        </div>
        <div class="field">
          <label class="field__label" for="pf-email">Email</label>
          <input type="email" id="pf-email" class="input" value="nattawat@email.com">
        </div>
        <div class="field">
          <label class="field__label" for="pf-phone">Phone</label>
          <input type="tel" id="pf-phone" class="input" value="081-234-5678">
        </div>
        <div class="field">
          <label class="field__label" for="pf-address">Default address</label>
          <input type="text" id="pf-address" class="input" value="42 Soi Sukhumvit 21, Bangkok">
        </div>
        <button type="submit" class="btn btn--primary" style="justify-self:start">Save changes</button>
      </form>
    </div>
  </div>
</main>

<script src="js/main.js"></script>
<script>
document.getElementById('profile-form').addEventListener('submit', (e) => {
  e.preventDefault();
  pmToast('Profile updated');
});
</script>
</body>
</html>
