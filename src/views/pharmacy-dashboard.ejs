<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Pharmacy Dashboard — Panmacy</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="css/variables.css">
<link rel="stylesheet" href="css/base.css">
<link rel="stylesheet" href="css/components.css">
</head>
<body>

  <%- include("element/nav") %>

<div class="dash-layout">
  <aside class="dash-sidebar">
    <div class="dash-sidebar__label">Pharmacy</div>
    <button type="button" class="dash-nav-item is-active" data-pharm-tab="dashboard">
      <svg viewBox="0 0 18 18" fill="none"><rect x="2" y="2" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.4"/><rect x="10" y="2" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.4"/><rect x="2" y="10" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.4"/><rect x="10" y="10" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.4"/></svg>
      Dashboard
    </button>
    <button type="button" class="dash-nav-item" data-pharm-tab="products">
      <svg viewBox="0 0 18 18" fill="none"><rect x="3" y="3" width="12" height="12" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M6 7h6M6 10h4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
      Manage products
    </button>
    <button type="button" class="dash-nav-item" data-pharm-tab="orders">
      <svg viewBox="0 0 18 18" fill="none"><path d="M3 4h12v10a1 1 0 01-1 1H4a1 1 0 01-1-1V4zM6 4V3a3 3 0 016 0v1" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
      Manage orders
    </button>
    <button type="button" class="dash-nav-item" data-pharm-tab="profile">
      <svg viewBox="0 0 18 18" fill="none"><path d="M3 14V6l6-3 6 3v8H3z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M7 14v-4h4v4" stroke="currentColor" stroke-width="1.4"/></svg>
      Edit shop profile
    </button>
  </aside>

  <main class="dash-main">
    <!-- Dashboard -->
    <section data-pharm-panel="dashboard">
      <div class="dash-header">
        <div>
          <h1>SafeCare Pharmacy</h1>
          <p style="color:var(--pm-ink-500);margin-top:4px;font-size:var(--fs-small)">Sukhumvit Branch · Owner dashboard</p>
        </div>
      </div>
      <div class="stat-grid">
        <div class="stat-card">
          <div class="stat-card__label">Revenue (30 days)</div>
          <div class="stat-card__value">฿128,450</div>
          <div class="stat-card__hint">+12% vs last month</div>
        </div>
        <div class="stat-card">
          <div class="stat-card__label">Orders (30 days)</div>
          <div class="stat-card__value">312</div>
          <div class="stat-card__hint">Avg ฿412 / order</div>
        </div>
        <div class="stat-card">
          <div class="stat-card__label">Products live</div>
          <div class="stat-card__value">186</div>
          <div class="stat-card__hint">4 low stock</div>
        </div>
        <div class="stat-card">
          <div class="stat-card__label">Rating</div>
          <div class="stat-card__value">4.8</div>
          <div class="stat-card__hint">from 420 reviews</div>
        </div>
      </div>
      <div class="panel">
        <div class="panel__head">
          <span class="panel__title">Top 3 recent orders</span>
          <button type="button" class="btn btn--sm" style="border:1px solid var(--pm-line-200)" data-pharm-tab-link="orders">View all</button>
        </div>
        <div class="panel__body" style="padding:0">
          <table class="table">
            <thead>
              <tr><th>Order</th><th>Customer</th><th>Items</th><th>Total</th><th>Status</th></tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>#PM-88421</strong><br><span style="font-size:var(--fs-xs);color:var(--pm-ink-500)">29 Sep 2026 · 14:22</span></td>
                <td>Nattawat S.</td>
                <td>Paracetamol ×2, Vitamin C</td>
                <td>฿95</td>
                <td><span class="badge badge--pending">Preparing</span></td>
              </tr>
              <tr>
                <td><strong>#PM-88418</strong><br><span style="font-size:var(--fs-xs);color:var(--pm-ink-500)">29 Sep 2026 · 11:05</span></td>
                <td>Somchai W.</td>
                <td>Cetirizine 10mg ×1</td>
                <td>฿45</td>
                <td><span class="badge badge--approved">Ready</span></td>
              </tr>
              <tr>
                <td><strong>#PM-88410</strong><br><span style="font-size:var(--fs-xs);color:var(--pm-ink-500)">28 Sep 2026 · 19:40</span></td>
                <td>Arunee P.</td>
                <td>Ibuprofen gel, Masks ×5</td>
                <td>฿210</td>
                <td><span class="badge badge--approved">Completed</span></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Manage products -->
    <section data-pharm-panel="products" hidden>
      <div class="dash-header">
        <div>
          <h1>Manage products</h1>
          <p style="color:var(--pm-ink-500);margin-top:4px;font-size:var(--fs-small)">Add, edit, and update stock</p>
        </div>
        <button type="button" class="btn btn--primary" id="btn-add-product">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          Add product
        </button>
      </div>
      <div class="panel" id="add-product-panel" hidden>
        <div class="panel__head">
          <span class="panel__title" id="product-form-title">Add product</span>
        </div>
        <div class="panel__body">
          <form id="product-form" style="display:grid;gap:16px;max-width:560px">
            <div class="field">
              <label class="field__label" for="p-name">Product name</label>
              <input type="text" id="p-name" class="input" required placeholder="e.g. Paracetamol 500mg 10 Tablets">
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
              <div class="field">
                <label class="field__label" for="p-price">Price (฿)</label>
                <input type="number" id="p-price" class="input" required min="1" placeholder="25">
              </div>
              <div class="field">
                <label class="field__label" for="p-stock">Stock</label>
                <input type="number" id="p-stock" class="input" required min="0" placeholder="100">
              </div>
            </div>
            <div class="field">
              <label class="field__label" for="p-cat">Category</label>
              <select id="p-cat" class="select" style="width:100%;height:46px">
                <option>Pain Relief/Fever</option>
                <option>Cold &amp; Flu</option>
                <option>Allergy</option>
                <option>Vitamins</option>
                <option>Digestive</option>
                <option>Skin Care</option>
              </select>
            </div>
            <div class="field">
              <label class="field__label" for="p-desc">Description</label>
              <textarea id="p-desc" class="input" style="height:90px;padding-top:12px;resize:vertical" placeholder="Short product description"></textarea>
            </div>
            <div style="display:flex;gap:8px">
              <button type="submit" class="btn btn--primary">Save product</button>
              <button type="button" class="btn" style="border:1px solid var(--pm-line-200)" id="cancel-product">Cancel</button>
            </div>
          </form>
        </div>
      </div>
      <div class="panel">
        <div class="panel__head">
          <span class="panel__title">Your catalog</span>
        </div>
        <div class="panel__body" style="padding:0">
          <table class="table" id="product-table">
            <thead>
              <tr><th>Product</th><th>Category</th><th>Price</th><th>Stock</th><th>Actions</th></tr>
            </thead>
            <tbody>
              <tr data-product>
                <td><strong>Paracetamol 500mg 10 Tablets</strong></td>
                <td>Pain Relief/Fever</td>
                <td>฿25</td>
                <td>240</td>
                <td>
                  <button type="button" class="btn btn--sm" style="border:1px solid var(--pm-line-200)" data-edit-product>Edit</button>
                </td>
              </tr>
              <tr data-product>
                <td><strong>Cetirizine 10mg 10 Tablets</strong></td>
                <td>Allergy</td>
                <td>฿45</td>
                <td>88</td>
                <td>
                  <button type="button" class="btn btn--sm" style="border:1px solid var(--pm-line-200)" data-edit-product>Edit</button>
                </td>
              </tr>
              <tr data-product>
                <td><strong>Vitamin C 1000mg 30 Tabs</strong></td>
                <td>Vitamins</td>
                <td>฿180</td>
                <td>42</td>
                <td>
                  <button type="button" class="btn btn--sm" style="border:1px solid var(--pm-line-200)" data-edit-product>Edit</button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Manage orders -->
    <section data-pharm-panel="orders" hidden>
      <div class="dash-header">
        <div>
          <h1>Manage orders</h1>
          <p style="color:var(--pm-ink-500);margin-top:4px;font-size:var(--fs-small)">Fulfill and update order status</p>
        </div>
      </div>
      <div class="panel">
        <div class="panel__body" style="padding:0">
          <table class="table">
            <thead>
              <tr><th>Order</th><th>Customer</th><th>Items</th><th>Total</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>#PM-88421</strong></td>
                <td>Nattawat S.</td>
                <td>Paracetamol ×2, Vitamin C</td>
                <td>฿95</td>
                <td><span class="badge badge--pending">Preparing</span></td>
                <td>
                  <button type="button" class="btn btn--sm btn--primary" onclick="this.closest('tr').querySelector('.badge').className='badge badge--approved';this.closest('tr').querySelector('.badge').textContent='Ready';pmToast('Marked ready')">Mark ready</button>
                </td>
              </tr>
              <tr>
                <td><strong>#PM-88418</strong></td>
                <td>Somchai W.</td>
                <td>Cetirizine 10mg ×1</td>
                <td>฿45</td>
                <td><span class="badge badge--approved">Ready</span></td>
                <td>
                  <button type="button" class="btn btn--sm btn--primary" onclick="this.closest('tr').querySelector('.badge').textContent='Completed';pmToast('Order completed')">Complete</button>
                </td>
              </tr>
              <tr>
                <td><strong>#PM-88410</strong></td>
                <td>Arunee P.</td>
                <td>Ibuprofen gel, Masks ×5</td>
                <td>฿210</td>
                <td><span class="badge badge--approved">Completed</span></td>
                <td>—</td>
              </tr>
              <tr>
                <td><strong>#PM-88392</strong></td>
                <td>Wipada N.</td>
                <td>Omeprazole 20mg ×1</td>
                <td>฿65</td>
                <td><span class="badge badge--pending">New</span></td>
                <td>
                  <button type="button" class="btn btn--sm btn--primary" onclick="this.closest('tr').querySelector('.badge').className='badge badge--pending';this.closest('tr').querySelector('.badge').textContent='Preparing';pmToast('Accepted order')">Accept</button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Edit shop profile -->
    <section data-pharm-panel="profile" hidden>
      <div class="dash-header">
        <div>
          <h1>Edit shop profile</h1>
          <p style="color:var(--pm-ink-500);margin-top:4px;font-size:var(--fs-small)">Public information shown to customers</p>
        </div>
      </div>
      <div class="panel">
        <div class="panel__body">
          <form id="shop-profile-form" style="display:grid;gap:16px;max-width:560px">
            <div class="field">
              <label class="field__label" for="shop-name">Pharmacy name</label>
              <input type="text" id="shop-name" class="input" value="SafeCare Pharmacy — Sukhumvit Branch">
            </div>
            <div class="field">
              <label class="field__label" for="shop-address">Address</label>
              <input type="text" id="shop-address" class="input" value="88 Sukhumvit Rd, Khlong Toei, Bangkok 10110">
            </div>
            <div class="field">
              <label class="field__label" for="shop-phone">Phone</label>
              <input type="tel" id="shop-phone" class="input" value="02-123-4567">
            </div>
            <div class="field">
              <label class="field__label" for="shop-hours">Opening hours</label>
              <input type="text" id="shop-hours" class="input" value="Mon–Sat 08:00–20:00 · Sun 09:00–18:00">
            </div>
            <div class="field">
              <label class="field__label" for="shop-about">About</label>
              <textarea id="shop-about" class="input" style="height:100px;padding-top:12px;resize:vertical">Licensed community pharmacy serving Sukhumvit since 2012. Verified on Panmacy.</textarea>
            </div>
            <button type="submit" class="btn btn--primary" style="justify-self:start">Save profile</button>
          </form>
        </div>
      </div>
    </section>
  </main>
</div>

<script src="js/main.js"></script>
<script>
(function () {
  const tabs = document.querySelectorAll('[data-pharm-tab]');
  const panels = document.querySelectorAll('[data-pharm-panel]');
  function showTab(id) {
    tabs.forEach((t) => t.classList.toggle('is-active', t.getAttribute('data-pharm-tab') === id));
    panels.forEach((p) => { p.hidden = p.getAttribute('data-pharm-panel') !== id; });
  }
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => showTab(tab.getAttribute('data-pharm-tab')));
  });
  document.querySelectorAll('[data-pharm-tab-link]').forEach((btn) => {
    btn.addEventListener('click', () => showTab(btn.getAttribute('data-pharm-tab-link')));
  });

  const addPanel = document.getElementById('add-product-panel');
  const formTitle = document.getElementById('product-form-title');
  const productForm = document.getElementById('product-form');
  document.getElementById('btn-add-product').addEventListener('click', () => {
    formTitle.textContent = 'Add product';
    productForm.reset();
    addPanel.hidden = false;
    showTab('products');
  });
  document.getElementById('cancel-product').addEventListener('click', () => {
    addPanel.hidden = true;
  });
  productForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = document.getElementById('p-name').value;
    const price = document.getElementById('p-price').value;
    const stock = document.getElementById('p-stock').value;
    const cat = document.getElementById('p-cat').value;
    const tbody = document.querySelector('#product-table tbody');
    const tr = document.createElement('tr');
    tr.setAttribute('data-product', '');
    tr.innerHTML = `<td><strong>${name}</strong></td><td>${cat}</td><td>฿${price}</td><td>${stock}</td>
      <td><button type="button" class="btn btn--sm" style="border:1px solid var(--pm-line-200)" data-edit-product>Edit</button></td>`;
    tbody.prepend(tr);
    addPanel.hidden = true;
    productForm.reset();
    pmToast('Product saved');
  });
  document.getElementById('product-table').addEventListener('click', (e) => {
    const btn = e.target.closest('[data-edit-product]');
    if (!btn) return;
    const row = btn.closest('tr');
    const name = row.querySelector('strong').textContent;
    formTitle.textContent = 'Edit product';
    document.getElementById('p-name').value = name;
    document.getElementById('p-price').value = row.cells[2].textContent.replace('฿', '');
    document.getElementById('p-stock').value = row.cells[3].textContent;
    document.getElementById('p-cat').value = row.cells[1].textContent;
    addPanel.hidden = false;
  });

  document.getElementById('shop-profile-form').addEventListener('submit', (e) => {
    e.preventDefault();
    pmToast('Shop profile updated');
  });
})();
</script>
</body>
</html>
