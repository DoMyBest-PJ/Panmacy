<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Pharmacy Dashboard — Panmacy</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="css/variables.css">
<link rel="stylesheet" href="css/base.css">
<link rel="stylesheet" href="css/components.css">
</head>
<body>

<div class="dash-layout dash-layout--standalone">
  <aside class="dash-sidebar">
    <div class="dash-sidebar__label">Pharmacy</div>
    <button type="button" class="dash-nav-item is-active" data-pharm-tab="dashboard">
      <svg viewBox="0 0 18 18" fill="none"><rect x="2" y="2" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.4"/><rect x="10" y="2" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.4"/><rect x="2" y="10" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.4"/><rect x="10" y="10" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.4"/></svg>
      Dashboard
    </button>
    <button type="button" class="dash-nav-item" data-pharm-tab="products">
      <svg viewBox="0 0 18 18" fill="none"><rect x="3" y="3" width="12" height="12" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M6 7h6M6 10h4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
      Manage products
    </button>
    <button type="button" class="dash-nav-item" data-pharm-tab="orders">
      <svg viewBox="0 0 18 18" fill="none"><path d="M3 4h12v10a1 1 0 01-1 1H4a1 1 0 01-1-1V4zM6 4V3a3 3 0 016 0v1" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
      Manage orders
    </button>
    <button type="button" class="dash-nav-item" data-pharm-tab="profile">
      <svg viewBox="0 0 18 18" fill="none"><path d="M3 14V6l6-3 6 3v8H3z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M7 14v-4h4v4" stroke="currentColor" stroke-width="1.4"/></svg>
      Edit shop profile
    </button>
  </aside>

  <div class="pharmacy-dashboard-content">
    <%- include('element/nav') %>
    <main class="dash-main">
    <% if (msg) { %>
      <div class="card" id="dashboard-message" role="alert" style="margin-bottom: var(--sp-4); padding: var(--sp-4);">
        <%= msg %>
      </div>
    <% } %>
    <!-- Dashboard -->
    <section data-pharm-panel="dashboard">
      <div class="dash-header">
        <div>
          <h1><%- pharname %></h1>
          <p style="color:var(--pm-ink-500);margin-top:4px;font-size:var(--fs-small)">Owner dashboard</p>
        </div>
      </div>
      <div class="stat-grid">
        <div class="stat-card">
          <div class="stat-card__label">Revenue (30 days)</div>
          <div class="stat-card__value">฿<%= Number(revenue).toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div>
          <div class="stat-card__hint">Sales from this pharmacy's products</div>
        </div>
        <div class="stat-card">
          <div class="stat-card__label">Orders (30 days)</div>
          <div class="stat-card__value"><%= orderCount %></div>
          <div class="stat-card__hint">Orders containing your products</div>
        </div>
        <div class="stat-card">
          <div class="stat-card__label">Products live</div>
          <div class="stat-card__value"><%= live %></div>
          <div class="stat-card__hint"><%= lowS %> low stock (Stock less than 5)</div>
        </div>
      </div>
      <div class="panel">
        <div class="panel__head">
          <span class="panel__title">Top 3 recent orders</span>
          <button type="button" class="btn btn--sm" style="border:1px solid var(--pm-line-200)" data-pharm-tab-link="orders">View all</button>
        </div>
        <div class="panel__body" style="padding:0">
          <table class="table">
            <thead>
              <tr><th>Order</th><th>Customer</th><th>Items</th><th>Total</th><th>Status</th></tr>
            </thead>
            <tbody>
              <% if (pharmacyOrders.length === 0) { %>
              <tr><td colspan="5">No orders for this pharmacy yet.</td></tr>
              <% } else { %>
                <% pharmacyOrders.slice(0, 3).forEach((order) => { %>
                <tr>
                  <td><strong>#<%= order.OrderID %></strong><br><span style="font-size:var(--fs-xs);color:var(--pm-ink-500)"><%= new Date(order.OrderDate).toLocaleString() %></span></td>
                  <td><%= order.CustomerName %></td>
                  <td><%= order.Items %></td>
                  <td>฿<%= Number(order.PharmacyTotal).toFixed(2) %></td>
                  <td><span class="badge"><%= order.Status %></span></td>
                </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Manage products -->
    <section data-pharm-panel="products" hidden>
      <div class="dash-header">
        <div>
          <h1>Manage products</h1>
          <p style="color:var(--pm-ink-500);margin-top:4px;font-size:var(--fs-small)">Add, edit, and update stock</p>
        </div>
        <button type="button" class="btn btn--primary" id="btn-add-product">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          Add product
        </button>
      </div>
      <div class="panel" id="add-product-panel" hidden>
        <div class="panel__head">
          <span class="panel__title" id="product-form-title">Add product</span>
        </div>
        <div class="panel__body">
          <form id="product-form" style="display:grid;gap:16px;max-width:560px" method="post" action="/pharmacy-add">
            <input type="hidden" id="p-id" value="">
            <div class="field">
              <label class="field__label" for="p-name">Product name</label>
              <input type="text" id="p-name" class="input" required placeholder="e.g. Paracetamol 500mg 10 Tablets" name="productname">
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
              <div class="field">
                <label class="field__label" for="p-price">Price (฿)</label>
                <input type="number" id="p-price" class="input" required min="0" step="0.01" placeholder="25" name="price">
              </div>
              <div class="field">
                <label class="field__label" for="p-stock">Stock</label>
                <input type="number" id="p-stock" class="input" required min="0" placeholder="100" name="quantity">
              </div>
            </div>
            <div class="field">
              <label class="field__label" for="p-cat">Category</label>
              <select id="p-cat" class="select" style="width:100%;height:46px" name="category">
                <option>Allergy</option>
                <option>Cold & Sore Throat</option>
                <option>Digestive Health</option>
                <option>First Aid</option>
                <option>Hygiene</option>
                <option>Pain & Fever Relief</option>
                <option>Skin Care</option>
                <option>Vitamins & Supplements</option>
              </select>
            </div>
            <div class="field">
              <label class="field__label" for="p-desc">Description</label>
              <textarea id="p-desc" class="input" style="height:90px;padding-top:12px;resize:vertical" placeholder="Short product description" name="description"></textarea>
            </div>
            <div style="display:flex;gap:8px">
              <button type="submit" class="btn btn--primary">Save product</button>
              <button type="button" class="btn" style="border:1px solid var(--pm-line-200)" id="cancel-product">Cancel</button>
            </div>
          </form>
        </div>
      </div>
      <div class="panel">
        <div class="panel__head">
          <span class="panel__title">Your catalog</span>
        </div>
        <div class="panel__body" style="padding:0">
          <table class="table" id="product-table">
            <thead>
              <tr><th>Product</th><th>Category</th><th>Price</th><th>Stock</th><th>Actions</th></tr>
            </thead>
            <tbody>
              <% if (products.length === 0) { %>
              <tr><td colspan="5">No products have been added yet.</td></tr>
              <% } else { %>
                <% products.forEach((product) => { %>
                <tr
                  data-product
                  data-product-id="<%= product.PharmacyProductID %>"
                  data-description="<%= product.Description || '' %>">
                  <td><strong><%= product.ProductName %></strong></td>
                  <td><%= product.Category %></td>
                  <td>฿<%= Number(product.Price).toFixed(2) %></td>
                  <td><%= product.Quantity %></td>
                  <td>
                    <button type="button" class="btn btn--sm" style="border:1px solid var(--pm-line-200)" data-edit-product>Edit</button>
                    <form method="post" action="/pharmacy-delete/<%= product.PharmacyProductID %>" style="display:inline" data-delete-product-form>
                      <button type="submit" class="btn btn--sm" style="border:1px solid var(--pm-line-200);color:var(--pm-coral-600)">Delete</button>
                    </form>
                  </td>
                </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Manage orders -->
    <section data-pharm-panel="orders" hidden>
      <div class="dash-header">
        <div>
          <h1>Manage orders</h1>
          <p style="color:var(--pm-ink-500);margin-top:4px;font-size:var(--fs-small)">Fulfill and update order status</p>
        </div>
      </div>
      <div class="panel">
        <div class="panel__body" style="padding:0">
          <table class="table">
            <thead>
              <tr><th>Order</th><th>Customer</th><th>Items</th><th>Total</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody>
              <% if (pharmacyOrders.length === 0) { %>
              <tr><td colspan="6">No orders for this pharmacy yet.</td></tr>
              <% } else { %>
                <% pharmacyOrders.forEach((order) => { %>
                <tr>
                  <td><strong>#<%= order.OrderID %></strong><br><span style="font-size:var(--fs-xs);color:var(--pm-ink-500)"><%= new Date(order.OrderDate).toLocaleString() %></span></td>
                  <td><%= order.CustomerName %></td>
                  <td><%= order.Items %></td>
                  <td>฿<%= Number(order.PharmacyTotal).toFixed(2) %></td>
                  <td><span class="badge"><%= order.Status %></span></td>
                  <td>
                    <form method="post" action="/pharmacy-order/<%= order.OrderID %>/status" style="display:flex;gap:8px;align-items:center">
                      <select name="status" class="select" aria-label="Order status">
                        <% ['PENDING', 'CONFIRMED', 'PROCESSING', 'SHIPPED', 'COMPLETED', 'CANCELLED'].forEach((status) => { %>
                        <option value="<%= status %>" <%= order.Status === status ? 'selected' : '' %>><%= status %></option>
                        <% }) %>
                      </select>
                      <button type="submit" class="btn btn--sm btn--primary">Update</button>
                    </form>
                  </td>
                </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Edit shop profile -->
    <section data-pharm-panel="profile" hidden>
      <div class="dash-header">
        <div>
          <h1>Edit shop profile</h1>
          <p style="color:var(--pm-ink-500);margin-top:4px;font-size:var(--fs-small)">Public information shown to customers</p>
        </div>
      </div>
      <div class="panel">
        <div class="panel__body">
          <form id="shop-profile-form" style="display:grid;gap:16px;max-width:560px" method="post" action="/pharmacy-update">
            <div class="field">
              <label class="field__label" for="shop-name">Pharmacy name</label>
              <input type="text" id="shop-name" class="input" value="<%= pharmacy.PharmacyName %>" name="name">
            </div>
            <div class="field">
              <label class="field__label" for="shop-address">Address</label>
              <input type="text" id="shop-address" class="input" value="<%= pharmacy.Address %>" name="address">
            </div>
            <div class="field">
              <label class="field__label" for="shop-phone">Contact Number</label>
              <input type="tel" id="shop-phone" class="input" value="<%= pharmacy.ContactNumber %>" name="phone">
            </div>
            <div class="field">
              <label class="field__label" for="shop-about">Description</label>
              <textarea id="shop-about" class="input" style="height:100px;padding-top:12px;resize:vertical" name="Description"><%= pharmacy.Description %></textarea>
            </div>
            <button type="submit" class="btn btn--primary" style="justify-self:start">Save profile</button>
          </form>
        </div>
      </div>
    </section>
    </main>
  </div>
</div>

<script src="js/main.js"></script>
<script>
(function () {
  const tabs = document.querySelectorAll('[data-pharm-tab]');
  const panels = document.querySelectorAll('[data-pharm-panel]');
  const dashboardMessage = document.getElementById('dashboard-message');
  function showTab(id, dismissMessage = true) {
    if (dismissMessage && dashboardMessage) dashboardMessage.remove();
    tabs.forEach((t) => t.classList.toggle('is-active', t.getAttribute('data-pharm-tab') === id));
    panels.forEach((p) => { p.hidden = p.getAttribute('data-pharm-panel') !== id; });
  }
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => showTab(tab.getAttribute('data-pharm-tab')));
  });
  document.querySelectorAll('[data-pharm-tab-link]').forEach((btn) => {
    btn.addEventListener('click', () => showTab(btn.getAttribute('data-pharm-tab-link')));
  });

  const addPanel = document.getElementById('add-product-panel');
  const formTitle = document.getElementById('product-form-title');
  const productForm = document.getElementById('product-form');
  const productIdInput = document.getElementById('p-id');
  const productNameInput = document.getElementById('p-name');
  const productPriceInput = document.getElementById('p-price');
  const productStockInput = document.getElementById('p-stock');
  const productCategoryInput = document.getElementById('p-cat');
  const productDescriptionInput = document.getElementById('p-desc');

  document.getElementById('btn-add-product').addEventListener('click', () => {
    formTitle.textContent = 'Add product';
    productForm.reset();
    productIdInput.value = '';
    productForm.action = '/pharmacy-add';
    addPanel.hidden = false;
    showTab('products');
  });
  document.getElementById('cancel-product').addEventListener('click', () => {
    addPanel.hidden = true;
  });
  document.getElementById('product-table').addEventListener('click', (e) => {
    const btn = e.target.closest('[data-edit-product]');
    if (!btn) return;
    const row = btn.closest('tr');
    const cells = row.cells;
    productIdInput.value = row.dataset.productId;
    productForm.action = `/pharmacy-edit/${encodeURIComponent(row.dataset.productId)}`;
    formTitle.textContent = 'Edit product';
    productNameInput.value = cells[0].querySelector('strong').textContent.trim();
    productPriceInput.value = cells[2].textContent.replace('฿', '').trim();
    productStockInput.value = cells[3].textContent.trim();
    productDescriptionInput.value = row.dataset.description;
    const category = cells[1].textContent.trim();
    if (![...productCategoryInput.options].some((option) => option.value === category)) {
      productCategoryInput.add(new Option(category, category));
    }
    productCategoryInput.value = category;
    addPanel.hidden = false;
    showTab('products');
  });

  document.getElementById('product-table').addEventListener('submit', (e) => {
    const form = e.target.closest('[data-delete-product-form]');
    if (form && !window.confirm('Delete this product from your catalog?')) {
      e.preventDefault();
    }
  });

  showTab('<%= activeTab %>', false);
})();
</script>
</body>
</html>
