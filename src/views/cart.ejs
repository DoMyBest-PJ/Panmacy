<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Shopping Cart — Panmacy</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="css/variables.css">
  <link rel="stylesheet" href="css/base.css">
  <link rel="stylesheet" href="css/components.css">
  <link rel="stylesheet" href="css/pages/products.css">
  <link rel="stylesheet" href="css/pages/product.css">
  <link rel="stylesheet" href="css/pages/cart.css">
</head>

<body>

  <%- include("element/nav") %>

  <main>
    <div class="container page-body">
      <h1>Shopping Cart</h1>
      <% if (msg) { %>
      <div class="card" role="alert" style="margin-top: var(--sp-4); padding: var(--sp-4);">
        <%= msg %>
      </div>
      <% } %>

      <div class="cart-layout">

        <!-- =========================================================
           CART ITEMS — grouped by pharmacy
      ========================================================= -->
        <section data-group="cart-items">

          <% if (pharmacyGroups.length === 0) { %>
          <div class="card empty-cart">
                    <h3>Your cart is empty</h3><br>
                    <a href="/" class="btn btn--primary">
                        Continue Shopping
                    </a>
                </div>

          <% } else { %>

          <% pharmacyGroups.forEach((pharmacy) => { %>

          <div class="pharmacy-group" data-pharmacy-id="<%= pharmacy.PharmacyID %>">

            <div class="pharmacy-group__head">

              <input type="checkbox" checked data-select-pharmacy aria-label="Select all items from this pharmacy">

              <div class="pharmacy-group__icon">
                <svg viewBox="0 0 16 16" fill="none">
                  <path d="M2 6l1-3h10l1 3M2 6v7a1 1 0 001 1h10a1 1 0 001-1V6M2 6h12" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
                </svg>
              </div>

              <span class="pharmacy-group__name">
                <%= pharmacy.PharmacyName %>
              </span>

              <span class="pharmacy-group__delivery">
                <%= pharmacy.PharmacyAddress || "" %>
              </span>

            </div>

            <div class="pharmacy-group__items">

              <% pharmacy.items.forEach((item) => { %>

              <div class="cart-item" data-item data-cart-item-id="<%= item.CartItemID %>" data-price="<%= item.Price %>" data-stock="<%= item.Stock %>" data-pharmacy="<%= item.PharmacyName %>" >

                <div class="cart-item__media tile--device">
                  <svg viewBox="0 0 48 48" fill="none">
                    <rect x="14" y="10" width="20" height="28" rx="4" fill="currentColor" opacity=".18" />
                    <path d="M18 18h12M18 24h12M18 30h8" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                  </svg>
                </div>

                <div class="cart-item__body">

                  <div class="cart-item__name">
                    <%= item.ProductName %>
                  </div>

                  <div class="cart-item__meta">
                    ฿<%= Number(item.Price).toFixed(2) %>
                    each
                  </div>

                  <% if (item.Stock <= 0) { %>
                  <span class="badge badge--stock-out">
                    Out of Stock
                  </span>
                  <% } %>

                </div>

                <div class="cart-item__controls">

                  <div class="qty-stepper qty-stepper--sm">

                    <button type="button" data-qty-minus aria-label="Decrease quantity">−</button>

                    <input type="number" value="<%= item.CartQuantity %>" min="1" max="<%= item.Stock %>" data-qty-input aria-label="Quantity">

                    <button type="button" data-qty-plus aria-label="Increase quantity">+</button>

                  </div>

                  <span class="cart-item__line-total" data-line-total>
                    ฿<%= (
                                        Number(item.Price) *
                                        Number(item.CartQuantity)
                                    ).toFixed(2) %>
                  </span>

                  <button type="button" class="icon-btn cart-item__remove" data-remove-item aria-label="Remove item">
                    <svg width="15" height="15" viewBox="0 0 15 15" fill="none">
                      <path d="M2.5 4h10M5.5 4V2.5h4V4M6 7v4M9 7v4M3.5 4l.6 8a1 1 0 001 .9h4l1-.9.6-8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </button>

                </div>

              </div>

              <% }) %>

            </div>
          </div>

          <% }) %>

          <% } %>

        </section>

        <!-- =========================================================
           ORDER SUMMARY — price breakdown, checkout
      ========================================================= -->
        <aside class="card summary-card" data-group="order-summary">

          <h3>Order Summary</h3>

          <div class="summary-row">
            <span>Items</span>
            <strong data-summary-subtotal>
              ฿<%= Number(subtotal).toFixed(2) %>
            </strong>
          </div>

          <div class="summary-row">
            <span>Delivery fee</span>
            <strong data-delivery-fee>
              ฿<%= Number(deliveryFee).toFixed(2) %>
            </strong>
          </div>

          <div class="summary-total">
            <span>Order Total</span>
            <span data-summary-total>
              ฿<%= Number(orderTotal).toFixed(2) %>
            </span>
          </div>

          <form action="/cart/checkout" method="post">
            <button
              type="submit"
              class="btn btn--primary btn--lg btn--block"
              data-checkout
              <%= pharmacyGroups.length === 0 ? 'disabled' : '' %>
              style="margin-top: var(--sp-5);">
              Proceed to Checkout
            </button>
          </form>

        </aside>
      </div>
    </div>
  </main>

  <footer class="footer">
    <div class="container">
      <p class="footer__note">© 2026 Panmacy. Every medicine purchase should follow a pharmacist's guidance</p>
    </div>
  </footer>



  <!-- Forum popup (Facebook-style) -->
  <div class="modal-backdrop" id="modal-forum" role="dialog" aria-modal="true" aria-labelledby="forum-modal-title">
    <div class="modal modal--fb">
      <div class="modal__header">
        <h2 class="modal__title" id="forum-modal-title">Create post</h2>
        <button type="button" class="modal__close" data-modal-close aria-label="Close">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
        </button>
      </div>
      <form id="forum-composer-form">
        <div class="modal__body">
          <div class="fb-post-composer">
            <div class="avatar">N</div>
            <textarea class="fb-post-input" name="content" placeholder="What's on your mind, Nattawat?" required></textarea>
          </div>
          <div class="fb-post-actions">
            <button type="button" class="fb-post-action">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                <rect x="2" y="3" width="14" height="12" rx="2" stroke="#45BD62" stroke-width="1.4" />
                <circle cx="6.5" cy="7.5" r="1.5" fill="#45BD62" />
                <path d="M2 12l3.5-3.5 2.5 2.5 3-3.5L16 12" stroke="#45BD62" stroke-width="1.4" stroke-linejoin="round" />
              </svg>
              Photo
            </button>
            <button type="button" class="fb-post-action">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                <path d="M3 14V5a1 1 0 011-1h4l1.5 2H14a1 1 0 011 1v7a1 1 0 01-1 1H4a1 1 0 01-1-1z" stroke="#F7B928" stroke-width="1.4" stroke-linejoin="round" />
              </svg>
              Tag
            </button>
            <button type="button" class="fb-post-action">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                <circle cx="9" cy="9" r="6.5" stroke="#F5533D" stroke-width="1.4" />
                <path d="M6 10.5c.8 1 1.9 1.5 3 1.5s2.2-.5 3-1.5M7 7.5h.01M11 7.5h.01" stroke="#F5533D" stroke-width="1.4" stroke-linecap="round" />
              </svg>
              Feeling
            </button>
          </div>
        </div>
        <div class="modal__footer">
          <button type="button" class="btn btn--ghost" data-modal-close>Cancel</button>
          <button type="submit" class="btn btn--primary">Post</button>
        </div>
      </form>
    </div>
  </div>

  <!-- New Thread popup -->
  <div class="modal-backdrop" id="modal-new-thread" role="dialog" aria-modal="true" aria-labelledby="thread-modal-title">
    <div class="modal modal--lg">
      <div class="modal__header">
        <h2 class="modal__title" id="thread-modal-title">Start a new thread</h2>
        <button type="button" class="modal__close" data-modal-close aria-label="Close">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
        </button>
      </div>
      <form id="new-thread-form">
        <div class="modal__body">
          <div class="field" style="margin-bottom:16px">
            <label class="field__label" for="thread-title">Title</label>
            <input type="text" id="thread-title" name="title" class="input" placeholder="e.g. Is it safe to take ibuprofen with antibiotics?" required>
          </div>
          <div class="field" style="margin-bottom:16px">
            <label class="field__label" for="thread-category">Category</label>
            <select id="thread-category" name="category" class="select" style="width:100%;height:46px">
              <option>General Health</option>
              <option>Pain Relief / Fever</option>
              <option>Cold &amp; Flu</option>
              <option>Allergy</option>
              <option>Digestive</option>
              <option>Skin Care</option>
              <option>Medication FAQ</option>
            </select>
          </div>
          <div class="field">
            <label class="field__label" for="thread-body">Your question or discussion</label>
            <textarea id="thread-body" name="body" class="input" style="height:140px;padding-top:12px;resize:vertical" placeholder="Describe your question in detail..." required></textarea>
          </div>
        </div>
        <div class="modal__footer">
          <button type="button" class="btn btn--ghost" data-modal-close>Cancel</button>
          <button type="submit" class="btn btn--primary">Post thread</button>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/main.js"></script>
  <script src="/js/pages/cart.js"></script>
</body>

</html>