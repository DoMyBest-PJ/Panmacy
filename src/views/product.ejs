<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Product — Panmacy</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/variables.css" />
  <link rel="stylesheet" href="/css/base.css" />
  <link rel="stylesheet" href="/css/components.css" />
  <link rel="stylesheet" href="/css/pages/product.css" />
  <link rel="stylesheet" href="/css/pages/products.css" />
</head>

<body>
  <%- include('element/nav') %>

  <main>
    <div class="container page-body">
      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Browse Products</a><span>/</span>
        <span class="current"><%= product.ProductName %></span>
      </nav>

      <div class="product-layout">
        <!-- =========================================================
           GALLERY
      ========================================================= -->
        <div data-group="gallery">
          <div class="card gallery__main tile--pain" data-gallery-main>
            <svg viewBox="0 0 48 48" fill="none">
              <rect x="14" y="10" width="20" height="28" rx="4" fill="currentColor" opacity=".18" />
              <path d="M18 18h12M18 24h12M18 30h8" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
          </div>
          <div class="gallery__thumbs">
            <button class="gallery__thumb tile--pain is-active" data-thumb>
              <svg viewBox="0 0 48 48" fill="none">
                <rect x="14" y="10" width="20" height="28" rx="4" fill="currentColor" opacity=".18" />
                <path d="M18 18h12M18 24h12M18 30h8" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
            </button>
            <button class="gallery__thumb tile--pain" data-thumb>
              <svg viewBox="0 0 48 48" fill="none">
                <rect x="16" y="16" width="16" height="16" rx="3" fill="currentColor" opacity=".18" />
                <path d="M20 24h8" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
            </button>
            <button class="gallery__thumb tile--pain" data-thumb>
              <svg viewBox="0 0 48 48" fill="none">
                <circle cx="24" cy="24" r="10" fill="currentColor" opacity=".18" />
                <path d="M19 24h10" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
            </button>
            <button class="gallery__thumb tile--pain" data-thumb>
              <svg viewBox="0 0 48 48" fill="none">
                <path d="M16 16h16v16H16z" fill="currentColor" opacity=".18" />
                <path d="M20 20l8 8m0-8l-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
            </button>
          </div>
        </div>

        <!-- =========================================================
           PRODUCT INFO — hierarchy: category → name → meta → price
           → seller → CTA → quantity/add-to-cart → delivery
      ========================================================= -->
        <div data-group="product-info">
          <span class="product-info__category"><%= product.Category %></span>
          <h1 class="product-info__name"><%= product.ProductName %></h1>

          <div class="product-info__meta-row">
            <% if (product.Quantity > 0) { %>
            <span class="badge badge--stock-ok">In Stock</span>
            <% } else { %>
            <span class="badge badge--stock-out">Out of Stock</span>
            <% } %>
          </div>

          <div class="product-info__price-block">
            <span class="product-info__price" data-unit-price="<%= product.Price %>">฿<%= product.Price %></span>
          </div>

          <!-- Pharmacy seller card -->
          <div class="card seller-card" data-group="seller-card">
            <div class="seller-card__avatar"><%= product.PharmacyName.charAt(0) %></div>
            <div class="seller-card__body">
              <div class="seller-card__name-row">
                <span class="seller-card__name"><%= product.PharmacyName %></span>
                <span class="badge badge--verified"><svg viewBox="0 0 12 12" fill="none">
                    <path d="M2.5 6l2 2 4.5-4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>Verified Pharmacy</span>
              </div>
            </div>
            <div class="seller-card__actions">
            </div>
          </div>

          <!-- Quantity + Add to cart -->
          <% if (isLogin && product.Quantity > 0) { %>
          <div class="purchase-row" data-group="purchase">
            <div class="qty-stepper">
              <button type="button" data-qty-minus aria-label="Decrease quantity">
                −
              </button>
              <input type="number" value="1" min="1" max="<%= product.Quantity %>" inputmode="numeric" data-qty-input aria-label="Quantity" />
              <button type="button" data-qty-plus aria-label="Increase quantity">
                +
              </button>
            </div>
            <button type="button" class="btn btn--primary btn--lg" data-add-to-cart data-product-id="<%= product.PharmacyProductID %>">
              Add to Cart
            </button>
          </div>
          <% } %>

          <p class="stock-line">
            <svg width="15" height="15" viewBox="0 0 15 15" fill="none">
              <path d="M7.5 2l6 3.5v4L7.5 13 1.5 9.5v-4L7.5 2z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" />
            </svg>
            <%= product.Quantity %> left in stock
          </p>

          <!-- Delivery information -->
          <div class="delivery-info" data-group="delivery">
            <div class="delivery-info__row">
              <svg viewBox="0 0 18 18" fill="none">
                <rect x="1.5" y="5" width="10" height="8" rx="1.5" stroke="currentColor" stroke-width="1.3" />
                <path d="M11.5 8h3l2 2.5V13h-5V8z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
                <circle cx="5" cy="14.5" r="1.3" stroke="currentColor" stroke-width="1.1" />
                <circle cx="13.5" cy="14.5" r="1.3" stroke="currentColor" stroke-width="1.1" />
              </svg>
              <div>
                <strong>Delivered to you within 45–90 minutes</strong><span>From the Sukhumvit branch</span>
              </div>
            </div>
            <div class="delivery-info__row">
              <svg viewBox="0 0 18 18" fill="none">
                <path d="M3 5h12v9H3z" stroke="currentColor" stroke-width="1.3" />
                <path d="M3 5l6 5 6-5" stroke="currentColor" stroke-width="1.3" />
              </svg>
              <div>
                <strong>Delivery starts at ฿20</strong><span>Free delivery on orders over ฿300</span>
              </div>
            </div>
            <div class="delivery-info__row">
              <svg viewBox="0 0 18 18" fill="none">
                <path d="M9 2l6 2.5v4c0 4-2.5 6.5-6 7.5-3.5-1-6-3.5-6-7.5v-4L9 2z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
              </svg>
              <div>
                <strong>Checked by a pharmacist before every delivery</strong><span>For your safety</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- =========================================================
         PRODUCT INFORMATION TABS
    ========================================================= -->
      <div class="info-tabs" data-group="info-tabs">
        <div class="info-tabs__nav">
        </div>

        <div class="info-tabs__panel is-active" data-panel="desc">
          <h4>Product description</h4>
          <p><%= product.Description || "No product description is available." %></p>
        </div>
      </div>
  </main>

  <!-- =========================================================
         FOOTER
    ========================================================= -->
  <footer class="footer">
    <div class="container footer__inner">
      <a href="/" class="pm-logo">
        <svg class="pm-logo__mark" viewBox="0 0 32 32" fill="none">
          <rect width="32" height="32" rx="9" fill="#1D7A63" />
          <path d="M16 9v14M9 16h14" stroke="#FDFBF6" stroke-width="3.4" stroke-linecap="round" />
          <circle cx="23.5" cy="8.5" r="3" fill="#DB8B2C" />
        </svg>
        <span class="pm-logo__word">Panmacy</span>
      </a>
      <div class="footer__cols">
        <div class="footer__col">
          <h4>Products</h4>
          <ul>
            <li><a href="/">Browse Products</a></li>
            <li><a href="/cart">My Cart</a></li>
          </ul>
        </div>
        <div class="footer__col">
          <h4>Community</h4>
          <ul>
            <li><a href="/forum">Health Forum</a></li>
            <li><a href="chat.html">Pharmacist Chat</a></li>
          </ul>
        </div>
        <div class="footer__col">
          <h4>Account</h4>
          <ul>
            <li><a href="/login">Log In</a></li>
            <li><a href="/signup">Sign Up</a></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="container">
      <p class="footer__note">
        © 2026 Panmacy. Every medicine purchase should follow a pharmacist's
        guidance
      </p>
    </div>
  </footer>

  <!-- Forum popup (Facebook-style) -->
  <div class="modal-backdrop" id="modal-forum" role="dialog" aria-modal="true" aria-labelledby="forum-modal-title">
    <div class="modal modal--fb">
      <div class="modal__header">
        <h2 class="modal__title" id="forum-modal-title">Create post</h2>
        <button type="button" class="modal__close" data-modal-close aria-label="Close">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
        </button>
      </div>
      <form id="forum-composer-form">
        <div class="modal__body">
          <div class="fb-post-composer">
            <div class="avatar">N</div>
            <textarea class="fb-post-input" name="content" placeholder="What's on your mind, Nattawat?" required></textarea>
          </div>
          <div class="fb-post-actions">
            <button type="button" class="fb-post-action">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                <rect x="2" y="3" width="14" height="12" rx="2" stroke="#45BD62" stroke-width="1.4" />
                <circle cx="6.5" cy="7.5" r="1.5" fill="#45BD62" />
                <path d="M2 12l3.5-3.5 2.5 2.5 3-3.5L16 12" stroke="#45BD62" stroke-width="1.4" stroke-linejoin="round" />
              </svg>
              Photo
            </button>
            <button type="button" class="fb-post-action">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                <path d="M3 14V5a1 1 0 011-1h4l1.5 2H14a1 1 0 011 1v7a1 1 0 01-1 1H4a1 1 0 01-1-1z" stroke="#F7B928" stroke-width="1.4" stroke-linejoin="round" />
              </svg>
              Tag
            </button>
            <button type="button" class="fb-post-action">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                <circle cx="9" cy="9" r="6.5" stroke="#F5533D" stroke-width="1.4" />
                <path d="M6 10.5c.8 1 1.9 1.5 3 1.5s2.2-.5 3-1.5M7 7.5h.01M11 7.5h.01" stroke="#F5533D" stroke-width="1.4" stroke-linecap="round" />
              </svg>
              Feeling
            </button>
          </div>
        </div>
        <div class="modal__footer">
          <button type="button" class="btn btn--ghost" data-modal-close>
            Cancel
          </button>
          <button type="submit" class="btn btn--primary">Post</button>
        </div>
      </form>
    </div>
  </div>

  <!-- New Thread popup -->
  <div class="modal-backdrop" id="modal-new-thread" role="dialog" aria-modal="true" aria-labelledby="thread-modal-title">
    <div class="modal modal--lg">
      <div class="modal__header">
        <h2 class="modal__title" id="thread-modal-title">
          Start a new thread
        </h2>
        <button type="button" class="modal__close" data-modal-close aria-label="Close">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
        </button>
      </div>
      <form id="new-thread-form">
        <div class="modal__body">
          <div class="field" style="margin-bottom: 16px">
            <label class="field__label" for="thread-title">Title</label>
            <input type="text" id="thread-title" name="title" class="input" placeholder="e.g. Is it safe to take ibuprofen with antibiotics?" required />
          </div>
          <div class="field" style="margin-bottom: 16px">
            <label class="field__label" for="thread-category">Category</label>
            <select id="thread-category" name="category" class="select" style="width: 100%; height: 46px">
              <option>General Health</option>
              <option>Pain Relief / Fever</option>
              <option>Cold &amp; Flu</option>
              <option>Allergy</option>
              <option>Digestive</option>
              <option>Skin Care</option>
              <option>Medication FAQ</option>
            </select>
          </div>
          <div class="field">
            <label class="field__label" for="thread-body">Your question or discussion</label>
            <textarea id="thread-body" name="body" class="input" style="height: 140px; padding-top: 12px; resize: vertical" placeholder="Describe your question in detail..." required></textarea>
          </div>
        </div>
        <div class="modal__footer">
          <button type="button" class="btn btn--ghost" data-modal-close>
            Cancel
          </button>
          <button type="submit" class="btn btn--primary">Post thread</button>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/main.js"></script>
  <script src="/js/pages/product.js"></script>
</body>

</html>