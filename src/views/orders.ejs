<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>My Orders — Panmacy</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="css/variables.css">
<link rel="stylesheet" href="css/base.css">
<link rel="stylesheet" href="css/components.css">
</head>
<body>

  <%- include("element/nav") %>

<main class="container" style="padding:var(--sp-10) var(--sp-4)">
  <h1 style="font-family:var(--font-display);font-size:var(--fs-h2);margin-bottom:var(--sp-6)">My Orders</h1>
  <div class="panel">
    <div class="panel__body" style="padding:0">
      <table class="table">
        <thead>
          <tr><th>Order</th><th>Date</th><th>Pharmacy</th><th>Items</th><th>Total</th><th>Status</th></tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>#PM-88421</strong></td>
            <td>29 Sep 2026</td>
            <td>SafeCare Pharmacy</td>
            <td>Paracetamol ×2, Vitamin C</td>
            <td>฿95</td>
            <td><span class="badge badge--pending">Preparing</span></td>
          </tr>
          <tr>
            <td><strong>#PM-88102</strong></td>
            <td>20 Sep 2026</td>
            <td>MediPlus Chiang Mai</td>
            <td>Cetirizine ×1</td>
            <td>฿45</td>
            <td><span class="badge badge--approved">Delivered</span></td>
          </tr>
          <tr>
            <td><strong>#PM-87950</strong></td>
            <td>5 Sep 2026</td>
            <td>SafeCare Pharmacy</td>
            <td>Ibuprofen gel</td>
            <td>฿120</td>
            <td><span class="badge badge--approved">Delivered</span></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</main>

<script src="js/main.js"></script>
</body>
</html>
